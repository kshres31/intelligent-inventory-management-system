INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/inventory
INVENTORY_DB_USER=inventory_app
INVENTORY_DB_PASSWORD=local_inventory_password
# Optional: deliver alert notifications to an HTTP endpoint instead of the console.
INVENTORY_ALERT_WEBHOOK_URL=
INVENTORY_ALERT_WEBHOOK_SECRET=
INVENTORY_ALERT_WEBHOOK_TIMEOUT_SECONDS=10
# Demo only: lets the first CLI argument name the acting user without a password.
INVENTORY_DEMO_MODE=false
# HTTP API (mvn exec:java -Dexec.args=serve)
INVENTORY_API_HOST=127.0.0.1
INVENTORY_API_PORT=8080
